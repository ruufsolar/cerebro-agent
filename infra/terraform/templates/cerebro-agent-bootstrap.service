[Unit]
Description=Configure and activate Cerebro from Azure Key Vault
After=docker.service network-online.target
# Wants=, not Requires=: this script stops docker.service to mount the data disk under
# the configured data-root, and a Requires= dependency would propagate that stop back
# and terminate this unit mid-bootstrap without triggering Restart=on-failure.
Wants=docker.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cerebro-vm-bootstrap.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=60s
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
