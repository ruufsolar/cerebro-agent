subscription_id           = "00000000-0000-0000-0000-000000000000"
# Example only: replace with the region approved by Ruuf/platform.
location                  = "eastus2"
resource_group_name       = "rg-cerebro-prod"
name_prefix               = "cerebro-prod"
vm_size                   = "Standard_B2ms"
admin_username            = "cerebroadmin"
admin_ssh_public_key      = "ssh-ed25519 AAAA... senior-or-breakglass-key"
secret_operator_object_id = "00000000-0000-0000-0000-000000000000"
data_disk_size_gb         = 64
# gh api repos/ruufsolar/cerebro-agent --jq '{owner_id: .owner.id, repository_id: .id}'
github_owner_id           = 116316151
github_repository_id      = 1349707290

# Public HTTPS ingress for the monolith's bank-payment events. Leave ingress_hostname empty
# and nothing here is created: no public address, no inbound rule, no certificate. It must
# match the CEREBRO_PUBLIC_HOSTNAME the secret seeder reads, or the address and the listener
# end up on different names. See docs/operations/ingress.md.
ingress_hostname = ""
# ingress_hostname = "cerebro.ruuf.cl"
# Narrow this to the monolith's egress addresses once the platform owner confirms them.
# Port 80 stays open to the Internet regardless, for certificate renewal.
ingress_allowed_source_ranges = ["Internet"]
# Only when ruuf.cl (or a delegated zone) lives in Azure DNS. Otherwise create the A record
# wherever the zone is hosted, using the ingress_public_ip output.
dns_zone_name                = ""
dns_zone_resource_group_name = ""

tags = {
  environment = "production"
  managed-by  = "terraform"
  owner       = "finops"
  service     = "cerebro-agent"
}
