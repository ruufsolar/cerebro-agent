CEREBRO_IMAGE_REPOSITORY=replace-with-registry.azurecr.io/cerebro-agent
IMAGE_TAG=main
CEREBRO_DB_PASSWORD=replace-with-a-long-random-value
CEREBRO_WEB_MEM=512m
CEREBRO_CONTROL_WORKER_MEM=512m
CEREBRO_AGENT_WORKER_MEM=1536m
CEREBRO_SLACK_MEM=384m
CEREBRO_DB_MEM=1024m
CEREBRO_CADDY_MEM=256m
# Empty keeps Cerebro private. `ingress` adds the caddy service; the VM bootstrap sets it
# from Key Vault, together with the hostname and ACME address Caddy needs.
COMPOSE_PROFILES=
CEREBRO_PUBLIC_HOSTNAME=
CEREBRO_ACME_EMAIL=
