CEREBRO_ENVIRONMENT=local
CEREBRO_LOG_LEVEL=INFO
CEREBRO_LOG_FORMAT=json
CEREBRO_DATABASE_URL=postgresql://cerebro:local-dev-only@db:5432/cerebro
CEREBRO_READ_REPLICA_URL=
CEREBRO_ALLOW_NON_REPLICA_READONLY_DB=false
CEREBRO_SQL_MAX_CONNECTIONS=5
CEREBRO_SQL_MAX_OUTPUT_BYTES=65536

CEREBRO_SLACK_APP_TOKEN=
CEREBRO_SLACK_BOT_TOKEN=

CEREBRO_AZURE_OPENAI_ENDPOINT=
CEREBRO_AZURE_OPENAI_API_KEY=
CEREBRO_AZURE_DEPLOYMENT_MAIN=gpt-5-6-sol
CEREBRO_AZURE_DEPLOYMENT_SMALL=gpt-5-6-sol
CEREBRO_AZURE_OPENAI_USE_RESPONSES=true
CEREBRO_AZURE_REASONING_EFFORT=medium
CEREBRO_ROUTER_REASONING_EFFORT=low
CEREBRO_PROVIDER_REQUEST_TIMEOUT_SECONDS=180
CEREBRO_GENERAL_MAX_WORDS=180
OPENAI_AGENTS_DONT_LOG_MODEL_DATA=1
OPENAI_AGENTS_DONT_LOG_TOOL_DATA=1

CEREBRO_GLOBAL_MODE=off
CEREBRO_EXTERNAL_TRACING_ENABLED=false

CEREBRO_MAX_AGENT_TURNS=14
CEREBRO_SQL_STATEMENT_TIMEOUT_SECONDS=15
CEREBRO_SQL_MAX_ROWS=200
CEREBRO_MAX_IMAGES=4
CEREBRO_MAX_IMAGE_BYTES=8388608
CEREBRO_MAX_IMAGE_PIXELS=25000000
CEREBRO_SLACK_FILE_TIMEOUT_SECONDS=15
CEREBRO_SLACK_IMAGE_BATCH_TIMEOUT_SECONDS=30
CEREBRO_IMAGE_TEMP_ROOT=/tmp/cerebro-images
CEREBRO_SLACK_DELIVERY_MAX_ATTEMPTS=3
CEREBRO_READINESS_PROFILE=foundation
CEREBRO_WORKER_CONCURRENCY=2
CEREBRO_RUNTIME_HEARTBEAT_SECONDS=15
CEREBRO_RUNTIME_STALE_SECONDS=45

CEREBRO_PUBLIC_URL=http://localhost:8000

# --- public HTTPS ingress for the monolith's bank-payment events ---------------
# Leave CEREBRO_PUBLIC_HOSTNAME empty and Cerebro has no public listener at all: no
# certificate, no Caddy container, no inbound Azure rule. Setting it in the approved
# production .env is what turns the whole path on, through Key Vault and the VM bootstrap.
# See docs/integrations.md.
CEREBRO_PUBLIC_HOSTNAME=
# Where the certificate authority writes about expiry or revocation. Required with a hostname.
CEREBRO_ACME_EMAIL=

# Cerebro validates the monolith's Authentik M2M token itself; the proxy only refuses a
# request with no bearer credential at all. All three are required with a hostname.
# Issuer is the Authentik provider URL, including its trailing slash.
CEREBRO_BANK_INGESTION_ENABLED=false
CEREBRO_BANK_INGESTION_ISSUER=
CEREBRO_BANK_INGESTION_AUDIENCE=
# The one Authentik client allowed to post bank movements, matched against the token's azp.
CEREBRO_BANK_INGESTION_CLIENT_ID=

# --- the shared memory of Ruuf's agents (ruufsolar/gru) -----------------------
# Leave RUUF_AGENTS_URL empty and Cerebro runs exactly as it did before: no
# brief above the general prompt, and no remember tool. In production these
# reach the VM through Key Vault: see infra/terraform/README.md, "Seed secrets".
RUUF_AGENTS_URL=https://agents.ruuf.solar
RUUF_AGENTS_M2M_CLIENT_ID=
RUUF_AGENTS_M2M_CLIENT_SECRET=
# Only if the Authentik provider is configured to demand one; it normally is not.
RUUF_AGENTS_M2M_SCOPE=
